# index.html — always revalidate so JS/CSS version strings are picked up immediately
/
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

# Versioned JS/CSS — cache forever (query string bust on change)
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable
